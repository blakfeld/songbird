# Songbird backend configuration. Copy to backend/.env for local development.
# Every variable can also be set in the process environment (which wins over .env).

# Address the API listens on. Must be a loopback address when using the codex provider.
SONGBIRD_BIND_ADDR=127.0.0.1:8080

# Deployment mode: production | development. Unset means production, which refuses to start
# with an operator-paid AI provider or any ANTHROPIC_API_KEY so a forgotten setting can never
# spend the operator's money; development is for local use and logs a warning at startup.
SONGBIRD_ENV=development

# Comma-separated keyring of <version>:<base64 32-byte key>; the first entry encrypts users'
# stored AI keys and the rest only decrypt, so old keys stay readable while rotating. Required
# in production and with the user and user-mock providers; optional here because the providers
# below do not store user keys. Generate an entry with `cargo run -p api -- keys generate-master-key` and put it first.
SONGBIRD_MASTER_KEYS=

# AI provider: claude | ollama | codex | mock | user | user-mock  (default when unset: user in
# production, claude in development)
#   ollama - free local model; recommended for everyday development
#   codex  - your ChatGPT subscription via the Codex CLI; local testing only
#   claude - Anthropic API (production default; costs API tokens)
#   mock   - deterministic built-in grooves; used by tests and CI
#   user   - each user's own stored API key pays; the only provider production accepts
#   user-mock - the user mode with fake providers, for tests and e2e; needs SONGBIRD_MASTER_KEYS
SONGBIRD_AI_PROVIDER=ollama

# Claude provider settings. ANTHROPIC_API_KEY is required when SONGBIRD_AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
SONGBIRD_AI_MODEL=claude-sonnet-5-5

# Model used when a user's active key is an OpenAI key. It must support strict JSON-schema
# output; users cannot choose their own, so the operator controls cost and behaviour.
SONGBIRD_OPENAI_MODEL=gpt-4.1-mini

# Comma-separated list of browser origins allowed to call the API (CORS).
SONGBIRD_CORS_ORIGINS=http://localhost:3000

# Abort a generation that takes longer than this many seconds (504 generation_timeout).
# Raise it for local models that cold-load slowly or for the codex provider.
SONGBIRD_GENERATION_TIMEOUT_SECS=60

# Maximum generation requests (patterns, track generation, chat) running at once. Further
# requests are rejected immediately with 503 generation_busy rather than queued. Allowed range 1-64.
SONGBIRD_MAX_CONCURRENT_GENERATIONS=4

# Maximum estimated tokens (ceil(chars / 4)) in a generation prompt. Allowed range 16-4096.
SONGBIRD_MAX_INPUT_TOKENS=256

# Maximum estimated tokens of song context (the other tracks' notes, tempo, key) sent with a
# track generation. Farthest measures are dropped first. Allowed range 0-32000; 0 sends none.
SONGBIRD_MAX_CONTEXT_TOKENS=4000

# Ollama provider settings.
SONGBIRD_OLLAMA_URL=http://localhost:11434
SONGBIRD_OLLAMA_MODEL=qwen2.5:7b-instruct

# Codex CLI provider settings. SONGBIRD_CODEX_MODEL is optional (blank = CLI default).
SONGBIRD_CODEX_BIN=codex
SONGBIRD_CODEX_MODEL=

# Database. The scheme picks the backend: sqlite:... or postgres://user:password@host:5432/dbname.
# Blank means SQLite at ./data/songbird.db (created on first start), meant for development and
# single-user use. For Postgres in production add ?sslmode=verify-full&sslrootcert=/path/ca.pem.
SONGBIRD_DATABASE_URL=

# Upper bound on pooled database connections. Allowed range 1-100.
SONGBIRD_DATABASE_MAX_CONNECTIONS=10

# Session cookie. Keep true for any https deployment (the cookie is then named
# __Host-songbird_session). Set false only for plain-http use such as local development;
# false together with an https:// entry in SONGBIRD_CORS_ORIGINS refuses to start.
SONGBIRD_COOKIE_SECURE=false

# Hours a session may sit idle before it expires. Allowed range 1-720. A session is also
# capped at 30 days regardless of activity.
SONGBIRD_SESSION_IDLE_HOURS=168

# Where the login and share-link throttles take the client address from.
#   false          the socket address (default; behind a proxy that is the proxy itself)
#   x-forwarded-for  the LAST X-Forwarded-For entry (alias: true). Safe only when the outermost
#                  proxy appends to or replaces X-Forwarded-For. Songbird's Next server passes
#                  it through unchanged and does not count as that proxy, so exposing Next
#                  directly with this mode is spoofable.
#   fly-client-ip  the Fly-Client-IP header. Safe only when the backend is reachable solely
#                  through Fly.io's proxy, which sets it.
SONGBIRD_TRUST_PROXY=false

# Per-user limits on endpoints that call the AI provider. Allowed ranges 1-600 and 1-100000.
# The per-minute window is in memory and resets on restart; the per-day count is stored.
SONGBIRD_AI_REQUESTS_PER_MINUTE=10
SONGBIRD_AI_REQUESTS_PER_DAY=200

# Limits on the public share-link listen API, per client address unless noted. They are held in
# memory and reset on restart. Reads cover the listen page and MIDI download (1-10000 per
# minute); comments are limited per address over 10 minutes (1-1000) and a day (1-10000), and
# per share link over a day (1-100000). Needs SONGBIRD_TRUST_PROXY behind a reverse proxy.
SONGBIRD_SHARE_READS_PER_MINUTE=60
SONGBIRD_COMMENTS_PER_ADDRESS_10M=5
SONGBIRD_COMMENTS_PER_ADDRESS_DAY=30
SONGBIRD_COMMENTS_PER_SHARE_DAY=200
